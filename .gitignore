# ============================================================
#  .gitignore — Arrakis / CMake + MSVC + OpenGL project
# ============================================================

# Build output directories
build/
out/
x64/
x86/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/

# Compiled binaries & object files
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.exp

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# vcpkg build cache & installed packages (keep vcpkg.json)
vcpkg_installed/

# Visual Studio / MSBuild files
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.VC.db
*.VC.VC.opendb
.vs/

# VS Code workspace settings (keep c_cpp_properties.json & tasks)
.vscode/launch.json
.vscode/settings.json
.vscode/ipch/

# Compiled shader cache / GPU driver cache
*.spv
*.bin

# Windows thumbnail & metadata
Thumbs.db
Desktop.ini
ehthumbs.db

# macOS (if ever touched on another machine)
.DS_Store

# Log files
*.log
