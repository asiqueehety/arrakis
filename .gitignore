# Out-of-source builds and generated configuration directories.
/build/
/build-*/
/out/
/x64/
/x86/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
_deps/

# Installed dependency copies are reproducible from vcpkg.json.
/vcpkg_installed/

# Compiler/linker output. Do NOT globally ignore *.obj: it can be a 3D asset.
*.o
*.a
*.exe
*.dll
*.so
*.so.*
*.dylib
*.lib
*.pdb
*.idb
*.ilk
*.exp
*.pch
*.tlog
*.obj.enc
*.exe.recipe
*.log

# Personal IDE state; shared projects and editor configuration stay tracked.
.vs/
*.vcxproj.user
*.suo
*.user
*.VC.db
*.VC.VC.opendb
.vscode/ipch/

# Python/documentation caches; the requested PDF itself stays tracked.
__pycache__/
*.py[cod]
.venv/
/docs/.cache/

# OS metadata and temporary editor files.
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*~
*.swp
*.swo
